{
  "name": "xivmind",
  "private": true,
  "version": "0.7.0",
  "description": "XivMind - AI-powered arXiv Paper Management System",
  "author": "XivMind Team",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:electron": "cross-env ENABLE_ELECTRON=true vite",
    "build": "vue-tsc && vite build",
    "build:frontend": "vue-tsc && vite build",
    "build:backend": "powershell -ExecutionPolicy Bypass -File scripts/build-backend.ps1",
    "build:backend-gpu": "powershell -ExecutionPolicy Bypass -File scripts/build-backend-gpu.ps1",
    "build:desktop": "electron-builder --win nsis",
    "build:desktop-gpu": "electron-builder --win nsis --config electron-builder-gpu.json",
    "build:all": "npm run build:frontend && npm run build:backend && npm run build:desktop",
    "build:all-gpu": "npm run build:frontend && npm run build:backend-gpu && npm run build:desktop-gpu",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "katex": "^0.16.28",
    "markdown-it": "^14.1.0",
    "markdown-it-katex": "^2.0.3",
    "pdfjs-dist": "^4.4.168",
    "pinia": "^2.1.0",
    "pinia-plugin-persistedstate": "^3.2.3",
    "vis-data": "^8.0.3",
    "vis-network": "^10.0.2",
    "vue": "^3.4.0",
    "vue-router": "^4.2.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.0.0",
    "@storybook/addon-a11y": "^10.2.4",
    "@storybook/addon-docs": "^10.2.4",
    "@storybook/addon-vitest": "^10.2.4",
    "@storybook/vue3-vite": "^10.2.4",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^20.10.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vitejs/plugin-vue-jsx": "^5.1.4",
    "@vitest/browser-playwright": "^4.0.18",
    "@vitest/coverage-v8": "^4.0.18",
    "@vue/test-utils": "^2.4.6",
    "concurrently": "^8.2.2",
    "cross-env": "^10.1.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "happy-dom": "^20.8.9",
    "jsdom": "^29.0.1",
    "playwright": "^1.58.1",
    "storybook": "^10.2.4",
    "typescript": "^5.9.3",
    "vite": "^5.0.0",
    "vite-plugin-electron": "^0.28.0",
    "vite-plugin-electron-renderer": "^0.14.5",
    "vite-plugin-vue-devtools": "^7.0.0",
    "vitest": "^4.0.18",
    "vue-tsc": "^3.2.4"
  }
}
