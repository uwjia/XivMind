# XivMind Desktop Configuration
# This file should be placed at: C:\Users\<username>\AppData\Roaming\XivMind\.env

# ============================================
# LLM Configuration for AI Assistant
# ============================================
# Provider: openai, anthropic, glm, ollama, deepseek, qwen
LLM_PROVIDER=openai

# Model name (gpt-4o-mini, gpt-4o, claude-3-haiku-20240307, glm-4-plus, llama3, deepseek-chat, etc.)
LLM_MODEL=gpt-4o-mini

# Temperature for response generation (0.0 - 1.0)
LLM_TEMPERATURE=0.7

# Maximum tokens in response
LLM_MAX_TOKENS=2048

# ============================================
# OpenAI Configuration
# ============================================
OPENAI_API_KEY=
OPENAI_BASE_URL=

# ============================================
# Anthropic Configuration
# Get API key from: https://console.anthropic.com
# ============================================
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=

# ============================================
# GLM (Zhipu AI) Configuration
# Get API key from: https://open.bigmodel.cn
# ============================================
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# ============================================
# DeepSeek Configuration
# Get API key from: https://platform.deepseek.com
# ============================================
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ============================================
# Qwen (Tongyi) Configuration
# Get API key from: https://dashscope.console.aliyun.com
# ============================================
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ============================================
# Ollama (Local LLM) Configuration
# Install Ollama from: https://ollama.ai
# ============================================
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ============================================
# Embedding Configuration
# ============================================
# Set to true to force using local model instead of OpenAI
USE_LOCAL_EMBEDDING=true

# Local model name (from sentence-transformers)
# Options: all-MiniLM-L6-v2, paraphrase-multilingual-MiniLM-L12-v2,
#          BAAI/bge-m3, BAAI/bge-large-zh, BAAI/bge-large-en
LOCAL_EMBEDDING_MODEL=BAAI/bge-m3

# Device for embedding computation
# Options: auto, cuda, mps, cpu
EMBEDDING_DEVICE=auto

# Hugging Face Endpoint (mirror for downloading models)
HF_ENDPOINT=https://hf-mirror.com

# ============================================
# Logging Configuration
# ============================================
LOG_LEVEL=INFO
LOG_CONSOLE_ENABLED=true
LOG_FILE_ENABLED=true
